#!/usr/bin/env python3
"""Check public GitHub downloads without applying configuration or fetching full Geo databases."""

import argparse
from concurrent.futures import ThreadPoolExecutor
import json
from pathlib import Path
import re
import subprocess
import sys
import tempfile
import tomllib
from urllib.request import Request, urlopen


def collect_downloads(repo, config=None, direct=False):
    """Render both platforms using host data, with secret lookup and Git externals disabled."""
    with tempfile.TemporaryDirectory(prefix="dotfiles-downloads-") as directory:
        root = Path(directory)
        base = ["chezmoi", "--source", str(repo), "--destination", str(root / "home"),
                "--cache", str(root / "cache"), "--persistent-state", str(root / "state"),
                "--refresh-externals=never", "--no-tty"]
        host = base + (["--config", str(config)] if config else [])
        configuration = json.loads(subprocess.check_output(host + ["dump-config", "--format", "json"]))
        data = configuration["data"]
        data["name"] = "Download Check"  # Never request the personal password store.
        data.setdefault("features", {})["inputMethod"] = False
        data["features"]["fduConnect"] = True
        data.setdefault("apps", {}).setdefault("hammerspoon", {})["enabled"] = True
        if direct:
            data.setdefault("downloads", {})["githubMirrorPrefix"] = ""
        safe_config = root / "config.json"
        # Render only public download links; do not invoke the user's secret command.
        safe_config.write_text(json.dumps({"data": data, "secret": {"command": "echo"}}))
        render = base + ["--config", str(safe_config), "--override-data", '{"chezmoi":{"os":"darwin"}}',
                         "execute-template", "--file"]
        externals = tomllib.loads(subprocess.check_output(render + [str(repo / ".chezmoiexternal.toml")], text=True))
        downloads = []
        for target, item in externals.items():
            if item.get("type") not in {"archive", "archive-file", "file"}:
                continue
            for index, url in enumerate(item.get("urls") or [item["url"]]):
                label = target if index == 0 else f"{target} [fallback {index}]"
                downloads.append((label, url))
        mihomo = subprocess.check_output(render + [str(repo / "dot_config/mihomo/config.yaml.tmpl")], text=True)
        for match in re.finditer(r'^\s*(url|geoip|geosite|mmdb):\s*"(https://[^"\s]+)"', mihomo, re.MULTILINE):
            url = match[2]
            if "https://github.com/" in url or "https://raw.githubusercontent.com/" in url:
                downloads.append(("mihomo/" + url.rsplit("/", 1)[-1], url))
        # The Homebrew bootstrap is another GitHub HTTP download; Git clone URLs stay out.
        bootstrap = '{{ includeTemplate "githubDownloadURL" (dict "config" . "url" "https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh") }}'
        url = subprocess.check_output(base + ["--config", str(safe_config), "execute-template", bootstrap], text=True)
        downloads.append(("Homebrew/install.sh", url))
        return list(dict.fromkeys(downloads))


def check_download(item, timeout):
    label, url = item
    try:
        # A bounded GET also works on hosts that reject HEAD. It detects HTTP 200 error pages.
        request = Request(url, headers={"User-Agent": "dotfiles-download-check", "Range": "bytes=0-4095"})
        with urlopen(request, timeout=timeout) as response:
            if response.status not in (200, 206):
                raise ValueError(f"HTTP {response.status}")
            content_type = response.headers.get_content_type()
            prefix = response.read(4096)
        if not prefix:
            raise ValueError("empty response")
        start = prefix.lstrip().lower()
        if content_type == "text/html" or start.startswith((b"<!doctype html", b"<html")):
            raise ValueError("received an HTML page instead of the resource")
        if url.endswith(".zip") and not prefix.startswith(b"PK\x03\x04"):
            raise ValueError("response is not a ZIP archive")
        # Probe checks availability/signatures only; chezmoi enforces any configured full checksum.
        return True, f"ok - {label}"
    except Exception as error:
        return False, f"FAIL - {label}: {error}\n  {url}"


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--config", type=Path, help="chezmoi config (defaults to the host config)")
    parser.add_argument("--direct", action="store_true", help="probe official URLs without the configured mirror")
    parser.add_argument("--list", action="store_true", help="list rendered public URLs without network requests")
    parser.add_argument("--filter", default="", help="check only labels or URLs containing this text")
    parser.add_argument("--timeout", type=float, default=15, help="timeout per network operation in seconds")
    args = parser.parse_args()
    if args.timeout <= 0:
        parser.error("timeout must be positive")
    repo = Path(__file__).resolve().parents[2]
    items = [item for item in collect_downloads(repo, args.config, args.direct)
             if args.filter.lower() in (item[0] + " " + item[1]).lower()]
    if not items:
        parser.error("no downloads matched")
    if args.list:
        for label, url in items:
            print(f"{label}\t{url}")
        return 0
    print(f"Checking {len(items)} public HTTP downloads (up to 4 KiB per URL).", flush=True)
    failures = []
    with ThreadPoolExecutor(max_workers=8) as pool:
        for ok, message in pool.map(lambda item: check_download(item, args.timeout), items):
            print(message, flush=True)
            if not ok:
                failures.append(message)
    print(f"\n{len(items) - len(failures)} passed; {len(failures)} failed.")
    if failures:
        print("\nFailure summary:\n" + "\n".join(failures))
    return bool(failures)


if __name__ == "__main__":
    try:
        sys.exit(main())
    except (OSError, subprocess.CalledProcessError, ValueError) as error:
        print(f"check-downloads: {error}", file=sys.stderr)
        sys.exit(1)
