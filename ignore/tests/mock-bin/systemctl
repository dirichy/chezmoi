#!/usr/bin/env bash
set -euo pipefail

if [[ ${DOTFILES_SERVICES_TEST:-0} == 1 && ${1:-} == --user ]]; then
    action=${2:-}
    unit=${3:-}
    case "$action:$unit" in
        is-enabled:config-share.service|is-enabled:fdu-connect.service)
            printf 'enabled\n'
            exit 0
            ;;
        is-enabled:later.path|is-enabled:later.service)
            printf 'disabled\n'
            exit 1
            ;;
        is-active:config-share.service)
            printf 'active\n'
            exit 0
            ;;
        daemon-reload:*|enable:*|disable:*|start:*)
            if [[ -n ${DOTFILES_SERVICE_CALLS:-} ]]; then
                printf 'systemctl' >>"$DOTFILES_SERVICE_CALLS"
                printf ' <%s>' "$@" >>"$DOTFILES_SERVICE_CALLS"
                printf '\n' >>"$DOTFILES_SERVICE_CALLS"
            fi
            exit 0
            ;;
        *)
            printf 'inactive\n'
            exit 1
            ;;
    esac
fi

if [[ ${1:-} == --user && ${2:-} == list-units ]]; then
    if [[ -n ${LATER_UNIT_LIST:-} && -f ${LATER_UNIT_LIST:-} ]]; then
        cat -- "$LATER_UNIT_LIST"
    fi
    exit 0
fi

if [[ ${LATER_SERVICES_READY:-1} == 0 && ${1:-} == --user ]]; then
    case ${2:-} in
        is-enabled|is-active)
            exit 1
            ;;
    esac
fi

if [[ -n ${LATER_CALLS:-} ]]; then
    printf 'systemctl' >>"$LATER_CALLS"
    printf ' <%s>' "$@" >>"$LATER_CALLS"
    printf '\n' >>"$LATER_CALLS"
fi
