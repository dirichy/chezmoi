{{- if and (ne .chezmoi.command "diff") (ne (env "DOTFILES_SKIP_HOOKS") "1") -}}
#!/bin/sh
set -eu

source_dir={{ .chezmoi.sourceDir | quote }}
if command -v git >/dev/null 2>&1 && git -C "$source_dir" rev-parse --git-dir >/dev/null 2>&1; then
    if [ "$(git -C "$source_dir" config --get core.hooksPath || true)" != .githooks ]; then
        git -C "$source_dir" config core.hooksPath .githooks || printf 'Warning: failed to configure repository hooks.\n' >&2
    fi
fi
{{ end -}}
