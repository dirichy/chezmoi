#!/bin/sh

set -eu

if ! command -v git >/dev/null 2>&1; then
	printf '%s\n' 'chezmoi: git not found; skipping repository hook configuration' >&2
	exit 0
fi

if ! git -C "$CHEZMOI_SOURCE_DIR" rev-parse --git-dir >/dev/null 2>&1; then
	printf '%s\n' 'chezmoi: source directory is not a Git repository; skipping hooks' >&2
	exit 0
fi

if ! git -C "$CHEZMOI_SOURCE_DIR" config core.hooksPath .githooks; then
	printf '%s\n' 'chezmoi: warning: failed to configure core.hooksPath' >&2
fi
