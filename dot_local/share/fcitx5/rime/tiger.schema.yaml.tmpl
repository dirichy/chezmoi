{{- $android := eq .chezmoi.os "android" -}}
input_keys:
  __include: default:/input_keys

features:
  keystroke_stats: {{ not $android }}



schema:
  author:
    - {}
  dependencies:
    - rime_ice # 拼音方案
  description: |
    虎码官方单字
    敲 ` 鍵進入拼音反查
  name: "虎码·常用"
  schema_id: tiger
  version: 0.9

# 普通开关随会话保留；下划线开头的手机键盘选项由 Rime 按方案初始化。
switches:
{{ if not $android }}
  - name: simp_hint
    states: [简码提醒关, 简码提醒开]
  - name: simp_record
    states: [简码统计关, 简码统计开]
{{ end }}
  - name: ascii_mode
    states: [中文, 西文] #中英文状态
  - name: pinyin #拼音滤镜
    states: [拼, pīn]
  - name: emoji #emoji滤镜
    states: [🈚, 🈶]
  - name: chaifen
    states: [拆隐, 拆显]
  # - options: [ gb2312, gbk, utf8 ]
  #   states: [ gb2312, GBK, UTF-8 ]
  #   reset: 0
  - name: traditionalization #简转繁滤镜
    states: [简中, 繁中]
{{ if not $android }}
  - options: [_keyboard_default, _keyboard_defaultbk, _keyboard_defaultwk]
    reset: 0
    states: [有刻, 半刻, 无刻]
  - name: charset_comment_filter #字符集提示
    states: [U区关, U区开]
  - name: udpf_switch
    states: [U编关, U编开]
{{ end }}
  - name: ascii_punct
    states: [。，, ．，]
{{ if not $android }}
  - options: [_keyboard_default, _keyboard_defaultzj]
    reset: 0
    states: [助记关, 助记开]
  # - name: fanjian  #繁转简滤镜
  #   reset: 0
  #   states: [ 反繁, 反简 ]
{{ end }}
  - name: full_shape
    states: [半角, 全角]

# Only used when the input session first starts.
session_defaults:
  emoji: false
  practice: {{ not $android }}

engine:
  processors:
    - lua_processor@*quick_input # 快符与 ;字母 命令的统一入口
    # - lua_processor@hammerspoon
{{ if not $android }}
    - lua_processor@*tiger.simp_tracker # 简码提醒与统计的独立组件
{{ end }}
    - ascii_composer
    - recognizer
    - key_binder
    - speller
    - punctuator
    - selector
    - navigator
    - express_editor #计算
  segmentors: # 分段
    - ascii_segmentor
    - matcher
    - lua_segmentor@*fixed4segmentor
    # - affix_segmentor@easy_english #英文相关
    - abc_segmentor
    - punct_segmentor
    - fallback_segmentor
  translators:
    - punct_translator
    - lua_translator@*symbol_menu # / 逐级符号菜单
    - reverse_lookup_translator #拼音反查
    - table_translator
{{ if not $android }}
    - lua_translator@*tiger.simp_stats # /simpstats 查看简码统计
{{ end }}
    - lua_translator@*schema_switch_translator # 方案菜单
    - lua_translator@*settings_menu # 设置菜单
    - lua_translator@*command_menu # 功能总菜单
    # - table_translator@easy_english #临时英文
{{ if not $android }}
    - history_translator@historyDM # 重复上屏 电脑
    - history_translator@historyDM2 # 重复上屏 电脑2
    - history_translator@historyDM3 # 重复上屏 电脑3
{{ end }}
    - lua_translator@*number_translator # 数字转大写
    - lua_translator@*calc_translator # 简易计算器
    - lua_translator@*date_translator # 公共日期时间工具
    - echo_translator

  filters:
    # - charset_filter@utf8
    # - charset_filter@gbk
    # - charset_filter@gb2312
    - simplifier@traditionalization #简繁滤镜
    - lua_filter@*tiger.reverse_comment # 反查词组补逐字虎码，优先保留真实整词码
    # - simplifier@fanjian #繁简滤镜
    - simplifier@pinyin #拼音滤镜
    - simplifier@chaifen #拆分滤镜
    - simplifier@emoji #表情滤镜
{{ if not $android }}
    - lua_filter@*charset_comment_filter #Unicode分区提示滤镜
    - lua_filter@*unicode_display #Unicode编码显示
{{ end }}
    - uniquifier #过滤重复
    - lua_filter@*quick_phrase_filter # 私人短语保留原文
    # 放在去重之后：即使首选恰好与重复字相同，也保留固定二选入口。
    - lua_filter@*tiger.repeat_last # z 的重复候选固定二选，由原生 selector 提交

speller:
  auto_clear: none # 3种选择， manual|auto|max_length 空码按下一键确认清屏|空码自动清|达到最长码时后码顶上清屏
  # max_code_length: 4
  alphabet: "[;'zyxwvutsrqponmlkjihgfedcba]"
  # initials: "abcdefghijklmnopqrstuvwxyz;'"

translator:
  dictionary: tiger_common.extended
  enable_charset_filter: false
  enable_encoder: false
  enable_sentence: false
  encode_commit_history: false
  max_phrase_length: 4
  enable_user_dict: false
  enable_completion: false # 编码提示 true 开启  false 关闭
  comment_format: #提示码自定义
    - "xform/~/ /" #去掉编码提示前的~号
    # - "xform/^/ /" #提示前面 +间距

# 拼音反查
reverse_lookup:
  dictionary: rime_ice
  prefix:
    __include: default:/input_keys/reverse_prefix
  tips: "〔拼音〕"
  preedit_format:
    - "xform/([nl])v/$1ü/"
    - "xform/([nl])ue/$1üe/"
    - "xform/([jqxy])v/$1u/"
  comment_format:
    - "xform/^/ /"
  # suffix: "'"

key_binder:
  #  import_preset: default
  bindings:
    #- { when: composing, accept: Return, send: Escape } # 回车清屏编码
    #- { accept: space, send: space, when: has_menu } # 有候选时空格上屏首选
    #- { accept: space, send: Escape, when: composing } # 无候选(空码）时空格清屏编码
    - { accept: { __include: default:/input_keys/select_second }, send: 2, when: has_menu } # 功能键二选：桌面分号，Android 反斜杠
    # - { accept: F13, toggle: ascii_mode, when: always}
    - { when: has_menu, accept: apostrophe, send: 3 } # 引号三选
{{ if not $android }}
    - { when: composing, accept: Tab, send: Escape } # tab清屏
    - { when: has_menu, accept: minus, send: Page_Up } # - 上一页
    - { when: composing, accept: { __include: default:/input_keys/backspace }, send: BackSpace } # 桌面额外支持反斜杠；Android 只用 Backspace
    - { when: has_menu, accept: equal, send: Page_Down } # = 下一页
{{ end }}
    # - { when: composing, accept: bracketleft, send: Page_Up } # [ 后翻
    # - { when: composing, accept: bracketright, send: Page_Down } # ] 前翻
{{ if not $android }}
    - { accept: "Control+o", toggle: traditionalization, when: composing } # 简繁开关
{{ end }}
    # - { accept: "Control+Shift+O", toggle: fanjian, when: composing }  # 繁简开关
{{ if not $android }}
    - { accept: "Control+p", toggle: pinyin, when: composing } # PC 拼音开关
    - { accept: "Control+i", toggle: emoji, when: composing } # PC emoji开关
    - { accept: "Control+u", toggle: charset_comment_filter, when: composing } # PC Unicode分区开关
    - { accept: "Control+y", toggle: udpf_switch, when: composing } #PC Unicode编码开关
    - { accept: "Control+j", toggle: chaifen, when: composing } # PC 拆分滤镜开关
{{ end }}
    # - { when: composing, accept: '&', toggle: emoji } # 手机 emoji开关
    # - { when: composing, accept: '*', toggle: traditionalization } # 手机 繁简开关
    # - { when: composing, accept: '\', toggle: pinyin } # 手机 拼音开关
    # - { when: composing, accept: '^', toggle: charset_comment_filter } # 手机 Unicode分区开关1
    # - { when: composing, accept: '#', toggle: charset_comment_filter } # 手机 Unicode分区开关2
    # - { accept: "%", toggle: udpf_switch, when: composing }  #手机 Unicode编码开关
    # - { accept: "+", toggle: udpf_switch, when: composing }  #手机 Unicode编码开关
    # - { when: composing, accept: '"', toggle: chaifen } # 手机 拆分滤镜开关
{{ if not $android }}
    - { when: has_menu, accept: Right, send: Down } # 右方向键 向后移动焦点
    - { when: has_menu, accept: Left, send: Up } # 左方向键 向前移动焦点
    - { when: always, accept: "Control+period", toggle: ascii_punct } # 中英标点切换
{{ end }}
    #- { when: always, accept: "Shift+space" , toggle: full_shape } # 全半角切换

recognizer:
  import_preset: default
  patterns:
    schema_switch:
      __include: default:/input_keys/command_pattern
    punct:
      __include: default:/input_keys/punct_pattern
    # uppercase: "" #中文状态大写锁定直接上屏
    reverse_lookup:
      __include: default:/input_keys/tiger_reverse_pattern
    # easy_english: "^'[A-Z|a-z]*`?$"
    number: "^S[0-9]+[.]?[0-9]*$" # 保留虎码 S 前缀
    calculator: "^=.+$"
# menu:
# page_size: 9 #候选数量
# alternative_select_labels: [ ㊀, ㊁, ㊂, ㊃, ㊄, ㊅, ㊆, ㊇, ㊈ ]  #自定义候选序号显示符

historyDM:
  input: "["
  size: 1
  initial_quality: 999

historyDM2:
  input: "'"
  size: 1
  initial_quality: -999

historyDM3:
  input: "]"
  size: 1
  initial_quality: 999

# ↓简繁(+部分异体)滤镜
traditionalization: #⇩四选一
  opencc_config: s2t.json # 与雾凇统一使用 OpenCC 标准简转繁
  # opencc_config: s2tw.json    # 简 ➡ 台湾正体
  # opencc_config: s2hk.json    # 简 ➡ 香港繁体
  # opencc_config: s2twp.json  # 简 ➡ 台湾正体（含常用词汇如：软体→軟體、鼠标→滑鼠）
  option_name: traditionalization
  tips: none # 候选本身已显示繁体，不重复提示转换前文字

# ↓繁简滤镜
fanjian:
  opencc_config: t2s.json # 繁 ➡ 简（OpenCC标准）
  option_name: fanjian

# ↓拼音滤镜
pinyin:
  opencc_config: pinyin.json
  option_name: pinyin
  show_in_comment: true #作为注解在后面显示
  excluded_types: [reverse_lookup] # 拼音反查应显示虎码
  comment_format:
    - "xform/&nbsp;/ /"
    # - "xform/^/ /"
  tips: char
  tags:
    - abc
    - tiger
    - tiger_full
    - tigress

# ↓emoji表情滤镜
emoji:
  opencc_config: {{ if $android }}emoji.json{{ else }}{{ joinPath .chezmoi.destDir ".local/share/fcitx5/rime/shared_emoji/emoji.json" | quote }}{{ end }}
  option_name: emoji
  tips: none # 不重复显示原文字

# 临时英文
# easy_english:
#   dictionary: easy_english
#   tag: easy_english
#   prefix: "'"
#   tips: 〔En〕
#   enable_completion: true
#   enable_sentence: false
#   initial_quality: -1
#   preedit_format:
#     - "xlit|_| |"
#   comment_format: #去掉编码提示前的~号
#     - "xform/~/ /"

# 拆分滤镜
chaifen:
  opencc_config: hu_cf.json
  option_name: chaifen
  show_in_comment: true
  comment_format:
    - "xform/&nbsp;/ /"
  tags:
    - abc
    - tiger
    - tiger_full
    - tigress
    - reverse_lookup
  tips: all #如只想给单字加滤镜，可改为 char

punctuator:
  import_preset: symbols

# 工具与雾凇共用实现，保留虎码的触发方式。
calculator:
  prefix: "="
