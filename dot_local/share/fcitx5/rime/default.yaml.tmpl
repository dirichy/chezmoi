{{- $android := eq .chezmoi.os "android" -}}
# Rime default settings
# encoding: utf-8

config_version: "2023-12-18"

# 平台差异在渲染时确定；编码本身保留实际输入键。
input_keys:
{{ if $android }}
  command_prefix: '\'
  reverse_prefix: '~'
  command_pattern: '^\\[so]?$'
  punct_pattern: '^(\\[A-Za-z]+|/q[A-Za-z0-9_/-]*|/([A-Za-z]+|[0-9]|10)?)$'
  tiger_reverse_pattern: "^~[a-z]*'?$"
  radical_pattern: '^~[a-z]*$'
  tiger_alphabet: "\\'zyxwvutsrqponmlkjihgfedcba"
  pinyin_alphabet: 'zyxwvutsrqponmlkjihgfedcbaZYXWVUTSRQPONMLKJIHGFEDCBA~\'
  select_second: backslash
{{ else }}
  command_prefix: ";"
  reverse_prefix: "`"
  command_pattern: "^;[so]?$"
  punct_pattern: "^(;[A-Za-z]+|/q[A-Za-z0-9_/-]*|/([A-Za-z]+|[0-9]|10)?)$"
  tiger_reverse_pattern: "^`[a-z]*'?$"
  radical_pattern: "^`[a-z]*$"
  tiger_alphabet: ";'zyxwvutsrqponmlkjihgfedcba"
  pinyin_alphabet: "zyxwvutsrqponmlkjihgfedcbaZYXWVUTSRQPONMLKJIHGFEDCBA`;"
  select_second: semicolon
  backspace: backslash
{{ end }}

schema_list:
  # - schema: lufs_flypy # 小鹤双拼
{{- if eq .inputMethod "tiger" }}
  - schema: tiger
  - schema: tiger_full
  - schema: rime_ice
  - schema: rime_ice_full
{{- else}}
  - schema: rime_ice
  - schema: rime_ice_full
  - schema: tiger
  - schema: tiger_full
{{- end}}

switcher:
  caption: "[方案菜单]"
{{ if $android }}
  hotkeys: []
{{ else }}
  hotkeys:
    - F4
{{ end }}
  save_options: [] # 只保留当前会话，不跨重启保存
  fold_options: false
  abbreviate_options: true
  option_list_separator: "/"

menu:
  page_size: 8

punctuator:
  full_shape:
    __include: symbols:/punctuator/full_shape
  half_shape:
    __include: symbols:/punctuator/half_shape

recognizer:
  patterns:
    # 禁止部分输入的自动上屏
    camel: "[a-z]+[A-Z].*$" # 驼峰命名
    email: "^[A-Za-z][-_.0-9A-Za-z]*@.*$" # email 地址
    html: "^<[a-z]+>$" # HTML TAG
    uppercase: "[A-Z][-_+.'0-9A-Za-z]*$" # 大写开头
    url: "^(www[.]|https?:|ftp[.:]|mailto:|file:).*$|^[a-z]+[.].+$" # URL 输入

    # 响应功能
    punct:
      __include: default:/input_keys/punct_pattern
    unicode: "^U[a-f0-9]+" # 响应 Unicode

ascii_composer:
  good_old_caps_lock: true
  switch_key:
    # Shift_L: commit_code
    # Shift_R: commit_code # macOS 上此项无效，Windows 可用右 Shift 切换中英输入
    Control_L: noop
    Control_R: noop # macOS 上此项无效，Windows 上可自行定义
    Caps_Lock: commit_code
    Eisu_toggle: clear

key_binder:
{{ if not $android }}
  select_first_character: "bracketleft" # lua 选词快捷键，选第一个字
  select_last_character: "bracketright" # lua 选词快捷键，选最后一个字
{{ end }}
  bindings:
{{ if not $android }}
    # Tab / Shift + Tab 翻页
    - { when: composing, accept: Tab, send: Page_Down } # Tab 向下翻页
    - { when: composing, accept: Shift+Tab, send: Page_Up } # Shift + Tab 向上翻页

    # = / - 翻页
    - { when: has_menu, accept: equal, send: Page_Down } # = 向下翻页
    - { when: has_menu, accept: minus, send: Page_Up } # - 上一页

    # . / , 翻页
    # 需要注释掉部分冲突的正则匹配才可用，详情见: https://github.com/LufsX/rime/issues/15#issuecomment-1496011933
    # - { when: paging, accept: period, send: Page_Down } # 句号向下翻页
    # - { when: paging, accept: comma, send: Page_Up } # 逗号向上翻页

    # ] / [ 翻页
    # 失效设置，可通过关闭/更改 lua 选词的快捷键恢复
    # - { when: paging, accept: bracketright, send: Page_Down } # 右括号向下翻页
    # - { when: paging, accept: bracketleft, send: Page_Up } # 左括号向上翻页

{{ end }}
    # 候选操作
    # ; 二选 ' 三选
    - { when: has_menu, accept: { __include: default:/input_keys/select_second }, send: 2 } # 功能键二选（Android 使用反斜杠）
    - { when: has_menu, accept: apostrophe, send: 3 } # 输入时「'」三选

{{ if not $android }}
    # Rime key bindings
    # numbered mode switch
    # - { when: always, accept: Control+Shift+1, select: .next } # 切换下一个方案
    - { when: always, accept: Control+Shift+1, toggle: full_shape } # 切换全角半角
    - { when: always, accept: Control+Shift+Alt+0, set_option: ascii_mode } # 切换全角半角
    - { when: always, accept: Control+Shift+Alt+9, unset_option: ascii_mode } # 切换全角半角
    - { when: always, accept: Control+Shift+2, toggle: ascii_punct } # 切换中英标点
    # - { when: always, accept: Control+Shift+4, toggle: traditionalization } # 切换简繁
    - { when: always, accept: Control+Shift+3, toggle: emoji } # 切换是否显示 Emoji


    # Rime key bindings
    # emacs_editing
    # - { when: composing, accept: Control+p, send: Up }
    # - { when: composing, accept: Control+n, send: Down }
    # - { when: composing, accept: Control+b, send: Left }
    # - { when: composing, accept: Control+f, send: Right }
    # - { when: composing, accept: Control+a, send: Home }
    # - { when: composing, accept: Control+e, send: End }
    # - { when: composing, accept: Control+d, send: Delete }
    # - { when: composing, accept: Control+k, send: Shift+Delete }
    # - { when: composing, accept: Control+h, send: BackSpace }
    # - { when: composing, accept: Control+g, send: Escape }
    # - { when: composing, accept: Control+bracketleft, send: Escape }
    # - { when: composing, accept: Control+y, send: Page_Up }
    # - { when: composing, accept: Alt+v, send: Page_Up }
    # - { when: composing, accept: Control+v, send: Page_Down }
{{ end }}
