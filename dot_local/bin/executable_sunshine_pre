#!/usr/bin/env bash
case "$1" in
  expand)
    hyprctl eval "hl.sunshine.expand(${SUNSHINE_CLIENT_WIDTH},${SUNSHINE_CLIENT_HEIGHT},${SUNSHINE_CLIENT_FPS})"
    sleep 5
    ;;
  mirror)
    hyprctl eval "hl.sunshine.mirror(${SUNSHINE_CLIENT_WIDTH},${SUNSHINE_CLIENT_HEIGHT},${SUNSHINE_CLIENT_FPS})"
    sleep 5
    ;;
  only)
    hyprctl eval "hl.sunshine.only(${SUNSHINE_CLIENT_WIDTH},${SUNSHINE_CLIENT_HEIGHT},${SUNSHINE_CLIENT_FPS})"
    sleep 5
    ;;
  reset)
    hyprctl eval "hl.sunshine.reset()"
    ;;
esac
exit 0
