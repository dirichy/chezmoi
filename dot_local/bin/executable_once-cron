#!/usr/bin/env bash
set -uo pipefail

state_dir=${XDG_STATE_HOME:-$HOME/.local/state}/once-cron
schedule_file=${ONCE_CRON_FILE:-$state_dir/tasks}
runtime_dir=${XDG_RUNTIME_DIR:-/tmp}
lock_file=$runtime_dir/once-cron-$(id -u).lock
now_value=${ONCE_CRON_NOW:-now}
self_path=$(readlink -f -- "$0")
systemctl_command=${ONCE_CRON_SYSTEMCTL:-systemctl}
systemd_run_command=${ONCE_CRON_SYSTEMD_RUN:-systemd-run}

log() {
    printf 'once-cron: %s\n' "$*"
}

parse_expiry() {
    local value=$1 number unit

    if [[ $value =~ ^([0-9]+)([smhd])$ ]]; then
        number=${BASH_REMATCH[1]}
        unit=${BASH_REMATCH[2]}
        case $unit in
            s) expiry_seconds=$number ;;
            m) expiry_seconds=$((number * 60)) ;;
            h) expiry_seconds=$((number * 60 * 60)) ;;
            d) expiry_seconds=$((number * 24 * 60 * 60)) ;;
        esac
        return 0
    fi

    return 1
}

file_signature() {
    stat -c '%d:%i:%y:%s' -- "$schedule_file"
}

compile_pending() {
    local output_file=$1 line trimmed task_status task_date task_time expiry command
    local line_number=0 dates_file records_file epochs_file

    dates_file=$(mktemp "$runtime_dir/once-cron-dates.XXXXXX") || return 1
    records_file=$(mktemp "$runtime_dir/once-cron-records.XXXXXX") || {
        rm -f -- "$dates_file"
        return 1
    }
    epochs_file=$(mktemp "$runtime_dir/once-cron-epochs.XXXXXX") || {
        rm -f -- "$dates_file" "$records_file"
        return 1
    }

    while IFS= read -r line || [[ -n $line ]]; do
        line_number=$((line_number + 1))
        trimmed=${line#"${line%%[![:space:]]*}"}
        [[ -n $trimmed && $trimmed != \#* ]] || continue

        read -r task_status task_date task_time expiry command <<<"$trimmed"
        if [[ -z ${task_status:-} || -z ${task_date:-} || -z ${task_time:-} || -z ${expiry:-} || -z ${command:-} ]]; then
            log "line $line_number is invalid; excluding it from scheduling"
            continue
        fi
        case $task_status in
            running | expired | failed) continue ;;
            pending) ;;
            *)
                log "line $line_number has an invalid status; excluding it from scheduling: $task_status"
                continue
                ;;
        esac
        if [[ ! $task_date =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ || ! $task_time =~ ^[0-9]{2}:[0-9]{2}(:[0-9]{2})?$ ]]; then
            log "line $line_number has an invalid time; excluding it from scheduling: $task_date $task_time"
            continue
        fi
        if ! parse_expiry "$expiry"; then
            log "line $line_number has an invalid expiry; excluding it from scheduling: $expiry"
            continue
        fi

        printf '%s %s\n' "$task_date" "$task_time" >>"$dates_file"
        printf '%s\t%s %s %s %s %s\n' \
            "$expiry_seconds" "$task_status" "$task_date" "$task_time" "$expiry" "$command" \
            >>"$records_file"
    done <"$schedule_file"

    if [[ -s $dates_file ]]; then
        if ! date -f "$dates_file" +%s >"$epochs_file"; then
            log 'one or more calendar dates are invalid; no tasks were scheduled'
            rm -f -- "$dates_file" "$records_file" "$epochs_file"
            return 1
        fi
        paste "$epochs_file" "$records_file" |
            awk -F '\t' 'BEGIN { OFS="\t" } { print $1, $1 + $2, $3 }' |
            sort -t $'\t' -k1,1n -- >"$output_file"
    else
        : >"$output_file"
    fi

    rm -f -- "$dates_file" "$records_file" "$epochs_file"
}

schedule_next() {
    local next_epoch=${1:-} desired_timer= unit
    local -a existing_timers=()

    while read -r unit _; do
        [[ $unit == once-cron-wakeup-*.timer ]] || continue
        existing_timers+=("$unit")
    done < <("$systemctl_command" --user list-units --all --plain --no-legend \
        'once-cron-wakeup-*.timer' 2>/dev/null || true)

    if [[ -n $next_epoch ]]; then
        desired_timer=once-cron-wakeup-$next_epoch.timer
    fi

    for unit in "${existing_timers[@]}"; do
        if [[ -z $desired_timer || $unit != "$desired_timer" ]]; then
            "$systemctl_command" --user stop "$unit" >/dev/null 2>&1 || true
        fi
    done

    if [[ -z $next_epoch ]]; then
        log 'no pending tasks remain'
        return 0
    fi
    for unit in "${existing_timers[@]}"; do
        if [[ $unit == "$desired_timer" ]]; then
            log "next wakeup is already scheduled for @$next_epoch"
            return 0
        fi
    done

    unit=${desired_timer%.timer}
    "$systemctl_command" --user stop "$unit.timer" "$unit.service" >/dev/null 2>&1 || true
    if "$systemd_run_command" --user --quiet --collect \
        --unit="$unit" --on-calendar="@$next_epoch" \
        --timer-property=AccuracySec=1s \
        "$self_path"; then
        log "scheduled next wakeup for @$next_epoch"
    else
        log "failed to schedule next wakeup for @$next_epoch"
        return 1
    fi
}

finish_task() {
    local expected=$1 replacement=$2 update_file line found=false

    flock 9
    update_file=$(mktemp "$(dirname -- "$schedule_file")/.once-cron.update.XXXXXX") || {
        flock -u 9
        return 1
    }
    while IFS= read -r line || [[ -n $line ]]; do
        if [[ $found == false && $line == "$expected" ]]; then
            [[ -z $replacement ]] || printf '%s\n' "$replacement" >>"$update_file"
            found=true
        else
            printf '%s\n' "$line" >>"$update_file"
        fi
    done <"$schedule_file"

    if [[ $found == true ]]; then
        chmod --reference="$schedule_file" "$update_file"
        mv -f -- "$update_file" "$schedule_file"
    else
        rm -f -- "$update_file"
        log 'task state changed while it was running; leaving it untouched'
    fi
    flock -u 9
    [[ $found == true ]]
}

[[ -f $schedule_file ]] || exit 0
mkdir -p "$runtime_dir"

exec 9>"$lock_file"
flock 9

if ! now_epoch=$(date -d "$now_value" +%s); then
    log "invalid current time: $now_value"
    exit 1
fi

compiled_file=$(mktemp "$runtime_dir/once-cron-compiled.XXXXXX") || exit 1
due_file=$(mktemp "$runtime_dir/once-cron-due.XXXXXX") || {
    rm -f -- "$compiled_file"
    exit 1
}
pending_file=$(mktemp "$(dirname -- "$schedule_file")/.once-cron.pending.XXXXXX") || {
    rm -f -- "$compiled_file" "$due_file"
    exit 1
}
cleanup() {
    rm -f -- "$compiled_file" "$due_file" "$pending_file"
}
trap cleanup EXIT

original_identity=$(file_signature) || exit 1
compile_pending "$compiled_file" || exit 1
if [[ $(file_signature) != "$original_identity" ]]; then
    log 'schedule changed while it was being read; trying again on the next trigger'
    exit 1
fi

declare -A due_kind=()
next_epoch=
while IFS=$'\t' read -r scheduled_epoch deadline_epoch task_line; do
    if ((scheduled_epoch > now_epoch)); then
        next_epoch=$scheduled_epoch
        break
    fi
    if ((now_epoch <= deadline_epoch)); then
        due_kind["$task_line"]=running
        printf 'running %s\n' "${task_line#pending }" >>"$due_file"
    else
        due_kind["$task_line"]=expired
    fi
done <"$compiled_file"

if ((${#due_kind[@]} > 0)); then
    while IFS= read -r line || [[ -n $line ]]; do
        trimmed=${line#"${line%%[![:space:]]*}"}
        read -r task_status task_date task_time expiry command <<<"$trimmed"
        canonical_line="$task_status $task_date $task_time $expiry $command"
        if [[ -n ${due_kind[$canonical_line]+set} ]]; then
            if [[ ${due_kind[$canonical_line]} == running ]]; then
                printf 'running %s %s %s %s\n' "$task_date" "$task_time" "$expiry" "$command" >>"$pending_file"
            else
                printf 'expired %s %s %s %s\n' "$task_date" "$task_time" "$expiry" "$command" >>"$pending_file"
                log "skipped expired task: $task_date $task_time $expiry $command"
            fi
        else
            printf '%s\n' "$line" >>"$pending_file"
        fi
    done <"$schedule_file"
    chmod --reference="$schedule_file" "$pending_file"
    mv -f -- "$pending_file" "$schedule_file"
fi

# Arrange the next wakeup before commands run, so a long-running command does
# not delay later tasks.
flock -u 9
schedule_status=0
schedule_next "$next_epoch" || schedule_status=1

status=$schedule_status
while IFS= read -r running_line; do
    read -r _ task_date task_time expiry command <<<"$running_line"
    log "running task from $task_date $task_time: $command"
    if bash -lc "$command"; then
        log "task succeeded: $command"
        finish_task "$running_line" '' || status=1
    else
        command_status=$?
        log "task failed with status $command_status: $command"
        failed_line="failed $task_date $task_time $expiry $command"
        finish_task "$running_line" "$failed_line" || true
        status=1
    fi
done <"$due_file"

exit "$status"
