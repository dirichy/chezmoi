#!/usr/bin/env bash

set -euo pipefail

input_files=("$@")

command_exists() {
	command -v "$1" >/dev/null 2>&1
}

copy_to() {
	if [ "${#input_files[@]}" -gt 0 ]; then
		cat -- "${input_files[@]}" | "$@"
	else
		"$@"
	fi
}

show_confirmation() {
	local dialog_cmd=$1 description=$2 tty_path=$3 reply=
	if ! { exec 3<>"$tty_path"; } 2>/dev/null; then
		printf 'copy: OSC 52 confirmation requires an interactive terminal\n' >&2
		return 1
	fi
	if [ -n "$dialog_cmd" ]; then
		"$dialog_cmd" --title 'OSC 52 clipboard copy' --defaultno \
			--yesno "$description" 10 68 <&3 >&3 2>&3
		return $?
	fi

	# Hosts without dialog/whiptail still require explicit confirmation.
	printf '%s [y/N] ' "$description" >&3
	IFS= read -r reply <&3 || return 1
	case $reply in
		y|Y|yes|YES) return 0 ;;
		*) return 1 ;;
	esac
}

confirm_osc52() {
	local dialog_cmd= description= tty_path=
	description="Copy $input_bytes bytes via OSC 52?"
	description="$description Large transfers may briefly stall the terminal."
	if command_exists dialog; then
		dialog_cmd=$(command -v dialog)
	elif command_exists whiptail; then
		dialog_cmd=$(command -v whiptail)
	fi

	if [ -n "${TMUX:-}" ] && command_exists tmux; then
		# copy-pipe runs in the background. Give the prompt its own TTY so the
		# pane's shell/TUI cannot consume the confirmation keys or redraw over it.
		{
			printf '%s\n' '#!/usr/bin/env bash' 'set -euo pipefail'
			declare -f show_confirmation
			printf '%s\n' 'show_confirmation "$1" "$2" /dev/tty && : >"$3"'
		} >"$work_dir/confirm.sh"
		tmux display-popup -E -w 76 -h 14 -t "${TMUX_PANE:-}" \
			"$BASH" "$work_dir/confirm.sh" "$dialog_cmd" "$description" "$work_dir/confirmed" \
			|| return 1
		# Closing the popup, ESC, or a tool error must never approve the copy.
		[ -f "$work_dir/confirmed" ]
		return $?
	fi

	tty_path=${SSH_TTY:-/dev/tty}
	show_confirmation "$dialog_cmd" "$description" "$tty_path"
}

if command_exists pbcopy; then
	copy_to pbcopy
	exit
fi

if [ -n "${WAYLAND_DISPLAY:-}" ] && command_exists wl-copy; then
	# wl-copy forks a clipboard owner but leaves stderr open. Detach it from the
	# terminal so the background process does not keep the PTY alive after exit.
	if copy_to wl-copy --type text/plain 2>/dev/null; then
		exit
	fi
	printf 'copy: wl-copy failed\n' >&2
	exit 1
fi

if [ -n "${DISPLAY:-}" ] && command_exists xclip; then
	copy_to xclip -selection clipboard
	exit
fi

if [ -n "${DISPLAY:-}" ] && command_exists xsel; then
	copy_to xsel --input --clipboard
	exit
fi

remote_tunnel_port=${COPY_REMOTE_TUNNEL_PORT:-}
if [ -z "$remote_tunnel_port" ] && [ -n "${TMUX:-}" ] && command_exists tmux; then
	remote_tunnel_port=$(tmux show-option -gvq '@copy_backend_remote_tunnel_port' 2>/dev/null || true)
fi

if [ -n "$remote_tunnel_port" ] && command_exists nc; then
	copy_to nc localhost "$remote_tunnel_port"
	exit
fi

if [ -n "${TMUX:-}" ] && command_exists tmux; then
	use_osc52=$(tmux show-option -gvq '@copy_use_osc52_fallback' 2>/dev/null || true)
	[ "$use_osc52" != off ] || exit 1
fi

work_dir=$(mktemp -d "${TMPDIR:-/tmp}/copy.XXXXXX")
input="$work_dir/input"
trap 'rm -f -- "$input" "$work_dir/confirm.sh" "$work_dir/confirmed"; rmdir -- "$work_dir"' EXIT
if [ "${#input_files[@]}" -gt 0 ]; then
	cat -- "${input_files[@]}" >"$input"
else
	cat >"$input"
fi

input_bytes=$(wc -c <"$input")
if [ "$input_bytes" -gt 65536 ]; then
	if ! confirm_osc52; then
		printf 'copy: OSC 52 copy cancelled\n' >&2
		exit 1
	fi
fi

emit_osc52() {
	local status=0
	if [ -n "${TMUX:-}" ]; then
		printf '\033Ptmux;\033\033]52;c;'
	else
		printf '\033]52;c;'
	fi
	# Stream the entire file once; Base64 contains no ESC bytes to escape for tmux.
	base64 <"$input" | tr -d '\r\n' || status=$?
	# Close the control sequence even if the encoder fails partway through.
	printf '\a'
	if [ -n "${TMUX:-}" ]; then
		printf '\033\\'
	fi
	return "$status"
}

target_tty=${SSH_TTY:-}
if [ -z "$target_tty" ] && [ -n "${TMUX_PANE:-}" ] && command_exists tmux; then
	target_tty=$(tmux display-message -p -t "$TMUX_PANE" '#{pane_tty}' 2>/dev/null || true)
fi
if [ -z "$target_tty" ] && [ -t 2 ]; then
	target_tty=/dev/tty
fi

if [ -n "$target_tty" ] && [ -w "$target_tty" ]; then
	emit_osc52 >"$target_tty"
else
	emit_osc52
fi
