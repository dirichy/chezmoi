#!/usr/bin/env bash

set -euo pipefail

input_files=("$@")

command_exists() {
	command -v "$1" >/dev/null 2>&1
}

copy_to() {
	if [ "${#input_files[@]}" -gt 0 ]; then
		cat -- "${input_files[@]}" | "$@"
	else
		"$@"
	fi
}

if command_exists pbcopy; then
	copy_to pbcopy
	exit
fi

if [ -n "${WAYLAND_DISPLAY:-}" ] && command_exists wl-copy; then
	# wl-copy forks a clipboard owner but leaves stderr open. Detach it from the
	# terminal so the background process does not keep the PTY alive after exit.
	if copy_to wl-copy --type text/plain 2>/dev/null; then
		exit
	fi
	printf 'copy: wl-copy failed\n' >&2
	exit 1
fi

if [ -n "${DISPLAY:-}" ] && command_exists xclip; then
	copy_to xclip -selection clipboard
	exit
fi

if [ -n "${DISPLAY:-}" ] && command_exists xsel; then
	copy_to xsel --input --clipboard
	exit
fi

remote_tunnel_port=${COPY_REMOTE_TUNNEL_PORT:-}
if [ -z "$remote_tunnel_port" ] && [ -n "${TMUX:-}" ] && command_exists tmux; then
	remote_tunnel_port=$(tmux show-option -gvq '@copy_backend_remote_tunnel_port' 2>/dev/null || true)
fi

if [ -n "$remote_tunnel_port" ] && command_exists nc; then
	copy_to nc localhost "$remote_tunnel_port"
	exit
fi

if [ -n "${TMUX:-}" ] && command_exists tmux; then
	use_osc52=$(tmux show-option -gvq '@copy_use_osc52_fallback' 2>/dev/null || true)
	[ "$use_osc52" != off ] || exit 1
fi

input=$(mktemp "${TMPDIR:-/tmp}/copy.XXXXXX")
trap 'rm -f -- "$input"' EXIT
if [ "${#input_files[@]}" -gt 0 ]; then
	cat -- "${input_files[@]}" >"$input"
else
	cat >"$input"
fi

max_bytes=74994
input_bytes=$(wc -c <"$input")
if [ "$input_bytes" -gt "$max_bytes" ]; then
	printf 'copy: input truncated by %d bytes for OSC 52\n' "$((input_bytes - max_bytes))" >&2
fi

payload=$(head -c "$max_bytes" "$input" | base64 | tr -d '\r\n')
osc=$(printf '\033]52;c;%s\a' "$payload")

if [ -n "${TMUX:-}" ]; then
	esc=$'\033'
	tmux_payload=${osc//$esc/$esc$esc}
	osc=$(printf '\033Ptmux;%s\033\\' "$tmux_payload")
fi

target_tty=${SSH_TTY:-}
if [ -z "$target_tty" ] && [ -n "${TMUX_PANE:-}" ] && command_exists tmux; then
	target_tty=$(tmux display-message -p -t "$TMUX_PANE" '#{pane_tty}' 2>/dev/null || true)
fi
if [ -z "$target_tty" ] && [ -t 2 ]; then
	target_tty=/dev/tty
fi

if [ -n "$target_tty" ] && [ -w "$target_tty" ]; then
	printf '%s' "$osc" >"$target_tty"
else
	printf '%s' "$osc"
fi
