{{- $heightPercent := 3.5 -}}
{{- $monitors := output "bash" "-lc" "out=$(hyprctl monitors -j 2>/dev/null); [[ $out == \\[* ]] && printf %s \"$out\" || printf []" | fromJson -}}
{{- $monitor := dict "height" 1000 "scale" 1 -}}
{{- if gt (len $monitors) 0 -}}
{{- $monitor = index $monitors 0 -}}
{{- range $m := $monitors -}}
{{- if $m.focused -}}
{{- $monitor = $m -}}
{{- end -}}
{{- end -}}
{{- end -}}
{{- $logicalHeight := divf $monitor.height (default 1 $monitor.scale) -}}
{{- $height := max 1 (int (printf "%.0f" (divf (mulf $logicalHeight $heightPercent) 100))) -}}
{{- define "px" -}}
{{- $percent := .percent -}}
{{- $height := .height -}}
{{- $scaled := int (printf "%.0f" (divf (mulf $height $percent) 100)) -}}
{{- if lt $percent 0 -}}{{ min -1 $scaled }}px{{- else if eq $percent 0 -}}0px{{- else -}}{{ max 1 $scaled }}px{{- end -}}
{{- end -}}

@import "styles/modules-left.css";
@import "styles/modules-center.css";
@import "styles/modules-right.css";

* {
	border: none;
	font-family: "0xProto Nerd Font", "Symbols Nerd Font";
	font-size: {{ template "px" (dict "percent" 70 "height" $height) }};
	font-weight: 800;
	min-height: 0;
	margin: 0;
	padding: 0;
	color: #cdd6f4;
}

window#waybar {
	background: rgba(17, 17, 27, 0.72);
	border-bottom: 1px solid rgba(203, 166, 247, 0.18);
	box-shadow: 0 2px 12px rgba(0, 0, 0, 0.36);
}

window#waybar > box {
	background: transparent;
	margin: 0;
}

tooltip {
	background: rgba(4, 4, 4, 0.8);
	border: 1px solid rgba(100, 114, 125, 0.5);
	border-radius: {{ template "px" (dict "percent" 24 "height" $height) }};
}

tooltip label {
	color: #cdd6f4;
	font-family: "Maple Mono", "Symbols Nerd Font Mono", monospace;
	font-weight: normal;
	margin: {{ template "px" (dict "percent" 6 "height" $height) }} {{ template "px" (dict "percent" 12 "height" $height) }};
}

#workspaces {
	transition: all 150ms ease-in-out;
}

#workspaces button {
	background: rgba(30, 30, 46, 0.58);
	border: 1px solid transparent;
	border-radius: 999px;
	color: #cdd6f4;
	margin: 0 {{ template "px" (dict "percent" 8 "height" $height) }};
	padding: {{ template "px" (dict "percent" 4 "height" $height) }} 0;
	transition: all 150ms ease-in-out;
}

#workspaces button.active {
	background: rgba(137, 180, 250, 0.9);
	border: 1px solid rgba(180, 190, 254, 0.5);
	border-radius: {{ template "px" (dict "percent" 32 "height" $height) }};
	color: #11111b;
	min-width: {{ template "px" (dict "percent" 140 "height" $height) }};
}

