}

#pulseaudio-slider trough {
	background: rgba(255, 255, 255, 0.25);
	border-radius: {{ template "px" (dict "percent" 16 "height" $height) }};
	min-height: {{ template "px" (dict "percent" 16 "height" $height) }};
	min-width: {{ template "px" (dict "percent" 240 "height" $height) }};
}

#pulseaudio-slider highlight {
	background: white;
	border-radius: {{ template "px" (dict "percent" 16 "height" $height) }};
	min-width: 0;
}
