{
	"hyprland/workspaces": {
		// "active-only":
		// "hide-active":
		// "all-outputs":
		"format": "{icon}",
		"format-icons": {
			"1": "󰲡",
			"2": "󰲣",
			"3": "󰲥",
			"4": "󰲧",
			"5": "󰲩",
			"6": "󰲫",
			"7": "󰲭",
			"8": "󰲯",
			"9": "󰲱",
			"default": "󰲳"
		},
		// "persistent-only":
		// "show-special":
		// "special-visible-only":
		// "sort-by":
		// "window-rewrite":
		// "window-rewrite-default":
		// "format-window-separator":
			// "move-to-monitor":
			// "ignore-workspaces":
			"on-click": "activate",
			"on-scroll-up": "hyprctl dispatch workspace +1",
			"on-scroll-down": "hyprctl dispatch workspace -1",
			"cursor": true
	}
}
