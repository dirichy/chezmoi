{
	"custom/system_update": {
		"exec": "~/.config/waybar/scripts/system-update.sh",
		"return-type": "json",
		"interval": 3600,
		"format": "{}",
		"min-length": 2,
		"max-length": 3,
		"on-click": "kitty --class system_menu --title system_menu -e ~/.config/waybar/scripts/system-update.sh start"
	}
}
