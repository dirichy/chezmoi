{{- $heightPercent := 3.25 -}}
{{- $monitors := output (joinPath .chezmoi.sourceDir "ignore/bin/hyprctl-safe") "monitors" "-j" "[]" | fromJson -}}
{{- $monitor := dict "height" 1000 "scale" 1 -}}
{{- if gt (len $monitors) 0 -}}
{{- $monitor = index $monitors 0 -}}
{{- range $m := $monitors -}}
{{- if $m.focused -}}
{{- $monitor = $m -}}
{{- end -}}
{{- end -}}
{{- end -}}
{{- $logicalHeight := divf $monitor.height (default 1 $monitor.scale) -}}
{{- $height := max 1 (int (printf "%.0f" (divf (mulf $logicalHeight $heightPercent) 100))) -}}
{{- $iconSize := max 1 (int (printf "%.0f" (divf (mulf $height 55) 100))) -}}
{{- $spacing := max 1 (int (printf "%.0f" (divf (mulf $height 20) 100))) -}}
{
	"tray": {
		"icon-size": {{ $iconSize }},
		"spacing": {{ $spacing }},
		"cursor": true
	}
}
