{
	"battery": {
		"states": {
			"warning": 20,
			"critical": 10
		},
		"format": "{icon} {capacity}%",
		"format-time": "{H} hr {M} min",
		"format-icons": [
			"󰂎", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"
		],
		"format-charging": "󰉁 {capacity}%",
		"min-length": 7,
		"max-length": 8,
		"tooltip-format": "Battery: {capacity}%\nRemaining: {time}",
		"tooltip-format-charging": "Battery: {capacity}%\nFull in: {time}",
		"events": {
			"on-discharging-warning": "notify-send -t 1000 'Low Battery' '{capacity}% battery remaining'",
			"on-discharging-critical": "notify-send -t 1000 'Low Battery' '{capacity}% battery remaining' -u critical",
			"on-charging-100": "notify-send -t 1000 'Battery full' 'Battery is at {capacity}%'"
		}
	}
}
