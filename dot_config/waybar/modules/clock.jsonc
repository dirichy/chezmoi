{
	"group/clock": {
		"orientation": "horizontal",
		"modules": [
			"clock#time",
			"clock#date"
		],
		"drawer": {
			"transition-left-to-right": false
		}
	},

	"clock#time": {
		"format": "{:%H:%M}",
		"min-length": 5,
		"max-length": 6,
		"on-click": "kitty --class system_menu --title system_menu -e calcurse",
		"tooltip-format": "{calendar}",
		"calendar": {
			"mode": "month",
			"mode-mon-col": 6,
			"format": {
				"months": "<span alpha='100%'><b>{}</b></span>",
				"days": "<span alpha='90%'>{}</span>",
				"weekdays": "<span alpha='80%'><i>{}</i></span>",
				"today": "<span alpha='100%'><b><u>{}</u></b></span>"
			}
		}
	},

	"clock#date": {
		"format": "󰸗 {:%m-%d}",
		"min-length": 8,
		"max-length": 9,
		"on-click": "kitty --class system_menu --title system_menu -e calcurse",
		"tooltip": false
	}
}
