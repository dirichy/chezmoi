{
	"group/system_monitor": {
		"orientation": "horizontal",
		"modules": [
			"cpu",
			"custom/gpu",
			"memory",
			"temperature"
		],
		"drawer": {}
	},

	"cpu": {
		"interval": 10,
		"format": "󰍛 {usage}%",
		"format-warning": "󰀨 {usage}%",
		"format-critical": "󰀨 {usage}%",
		"min-length": 7,
		"max-length": 8,
		"states": {
			"warning": 75,
			"critical": 90
		},
		"on-click": "kitty --class system_menu --title system_menu -e btm",
		"tooltip": false
	}
}
