#!/bin/zsh
# .zshenv - Zsh environment file, loaded always.
# ~/.zshenv sources this file; a standalone copy can also use ZDOTDIR directly.
export ZDOTDIR=${ZDOTDIR:-${${(%):-%N}:A:h}}
export XDG_CONFIG_HOME=${XDG_CONFIG_HOME:-$HOME/.config}
export XDG_DATA_HOME=${XDG_DATA_HOME:-$HOME/.local/share}
export XDG_CACHE_HOME=${XDG_CACHE_HOME:-$HOME/.cache}
if [[ $OSTYPE == darwin* ]]; then
    _zsh_brew_prefix=/usr/local
    [[ ! -d /opt/homebrew ]] || _zsh_brew_prefix=/opt/homebrew
    export C_INCLUDE_PATH="$_zsh_brew_prefix/include:$C_INCLUDE_PATH"
    export LIBRARY_PATH="$_zsh_brew_prefix/lib:$LIBRARY_PATH"
    export LD_LIBRARY_PATH="$_zsh_brew_prefix/lib:$LD_LIBRARY_PATH"
fi


# Ensure path arrays do not contain duplicates.
typeset -gU path fpath

# Set the list of directories that zsh searches for commands.
path=(
    $HOME/{,s}bin(N)
    $HOME/.local/{,s}bin(N)
    /opt/{homebrew,local}/{,s}bin(N)
    /usr/local/{,s}bin(N)
    $path
)
export EDITOR=nvim
{{- if not .features.desktop }}
case "$TERM" in
    xterm-kitty|xterm-ghostty|wezterm|foot|alacritty)
        export TERM=xterm-256color
        ;;
esac
{{- end }}
{{- if .features.proxy }}
export https_proxy=http://{{ .proxy.address }} http_proxy=http://{{ .proxy.address }} #all_proxy=socks5://{{ .proxy.address }}
{{- end }}
if [[ $OSTYPE == darwin* ]]; then
    path=("$_zsh_brew_prefix/bin" /Users/Shared/opt/bin $path $HOME/Library/Python/3.9/bin)
    unset _zsh_brew_prefix
fi
export PATH
