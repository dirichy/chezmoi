#!/bin/zsh
#
# .zshrc - Zsh file loaded on interactive shell sessions.
#

export ZDOTDIR=${ZDOTDIR:-${${(%):-%N}:A:h}}

# Enable Powerlevel10k instant prompt. Should stay close to the top of .zshrc.
# Initialization code that may require console input (password prompts, [y/n]
# confirmations, etc.) must go above this block; everything else may go below.

# Lazy-load (autoload) Zsh function files from a directory.
ZFUNCDIR=${ZDOTDIR:-$HOME}/.zfunctions
fpath=($ZFUNCDIR $fpath)
autoload -Uz $ZFUNCDIR/*(N.:t)
setopt interactivecomments

# for gopass
if [[ -n $SSH_TTY ]]; then
    export XDG_SESSION_TYPE=tty
fi

if [[ -n $SSH_TTY && -z $TMUX && -t 0 && -t 1 ]] && (( $+commands[tmux] )); then
    print -P "%F{cyan}SSH%f session detected. Choose a %F{green}tmux%f session, or press %B%F{yellow}[q]%f%b to stay in this shell."
    t --exec
fi

if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
    source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

bindkey -v

export FZF_DEFAULT_OPTS=" \
--color=bg+:#313244,bg:#1e1e2e,spinner:#f5e0dc,hl:#f38ba8 \
--color=fg:#cdd6f4,header:#f38ba8,info:#cba6f7,pointer:#f5e0dc \
--color=marker:#b4befe,fg+:#cdd6f4,prompt:#cba6f7,hl+:#f38ba8 \
--multi"

# selected-bg was introduced in fzf 0.52.0.
if (( $+commands[fzf] )); then
    autoload -Uz is-at-least
    _fzf_version=$(fzf --version 2>/dev/null)
    if [[ -n $_fzf_version ]] && is-at-least 0.52.0 "${_fzf_version%% *}"; then
        FZF_DEFAULT_OPTS+=' --color=selected-bg:#45475a'
    fi
    unset _fzf_version
fi

# Set any zstyles you might use for configuration.
[[ ! -f ${ZDOTDIR:-$HOME}/.zstyles ]] || source ${ZDOTDIR:-$HOME}/.zstyles

# Load plugins using the download backend selected by host data.
source "$ZDOTDIR/plugins.zsh"

# Source anything in .zshrc.d.
for _rc in ${ZDOTDIR:-$HOME}/.zshrc.d/*.zsh(N); do
    # Ignore tilde files.
    if [[ $_rc:t != '~'* ]]; then
        source "$_rc"
    fi
done
unset _rc

# To customize prompt, run `p10k configure` or edit .p10k.zsh.
[[ ! -f ${ZDOTDIR:-$HOME}/.p10k.zsh ]] || source ${ZDOTDIR:-$HOME}/.p10k.zsh
setopt NO_BEEP
export SUDO_PROMPT=$'[sudo] password for %p: '
if (( $+commands[fzf] )); then
    source <(fzf --zsh)
fi
if (( $+commands[brew] )); then
    _chruby_prefix=$(brew --prefix chruby 2>/dev/null)
    [[ -f "$_chruby_prefix/share/chruby/chruby.sh" ]] && . "$_chruby_prefix/share/chruby/chruby.sh"
    [[ -f "$_chruby_prefix/share/chruby/auto.sh" ]] && . "$_chruby_prefix/share/chruby/auto.sh"
    unset _chruby_prefix
fi
# chruby ruby-3.3.5
[[ -f "$HOME/.cargo/env" ]] && . "$HOME/.cargo/env"
. "${ZDOTDIR:-$HOME}/scripts/baipan/main.zsh"
(( $+commands[micromamba] )) && eval "$(micromamba shell hook --shell zsh)"
return 0
