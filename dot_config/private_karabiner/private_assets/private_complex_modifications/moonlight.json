{
  "rules": [
    {
      "description": "Swap command and option in Moonlight",
      "manipulators": [
        {
          "conditions": [
            {
              "bundle_identifiers": [
                "^com\\.moonlight-stream\\.Moonlight$"
              ],
              "type": "frontmost_application_if"
            }
          ],
          "from": {
            "key_code": "left_command"
          },
          "to": [
            {
              "key_code": "left_option"
            }
          ],
          "type": "basic"
        },
        {
          "conditions": [
            {
              "bundle_identifiers": [
                "^com\\.moonlight-stream\\.Moonlight$"
              ],
              "type": "frontmost_application_if"
            }
          ],
          "from": {
            "key_code": "left_option"
          },
          "to": [
            {
              "key_code": "left_command"
            }
          ],
          "type": "basic"
        }
      ]
    }
  ],
  "title": "moonlight"
}
