return {
	{
		vim.fn.isdirectory(vim.env.HOME .. "/flash-any.nvim/") == 0 and "dirichy/flash-any.nvim",
		dir = vim.fn.isdirectory(vim.env.HOME .. "/flash-any.nvim/") == 1 and vim.env.HOME .. "/flash-any.nvim",
		dependencies = { "folke/flash.nvim" },
		opts = {
			sources = {
		{{- if eq .inputMethod "tiger"}}
				{ name = "tiger", append_space_below = 4 },
    {{- else if eq .inputMethod "flypy"}}	
				{ name = "flypy"},
		{{- end }}
				"nerdfont",
				"unicode",
			},
		},
		config = function(_, opts)
			require("flash").setup({
				modes = {
					char = {
						matcher = function(win, state, range)
							return require("flash-any").char(win, state, range)
						end,
						-- multi_line = false, -- 只匹配当前行
					},
				},
			})
			require("flash-any").setup(opts)
		end,
		keys = {
			{
				"r",
				mode = "o",
				function()
					require("flash-any").remote()
				end,
				desc = "remote flash",
			},
			{
				"<c-s>",
				mode = { "c" },
				function()
					require("flash").toggle()
				end,
				desc = "toggle flash search",
			},
			{
				"s",
				mode = { "n", "x", "o" },
				function()
					require("flash-any").jump()
				end,
				desc = "flash any",
			},
		},
	},
}
