# Config groups controlled by host data.
{{ if not .apps.neovim.enabled }}
.config/nvim
{{ end }}
{{ if not .apps.mihomo.enabled }}
.config/mihomo
.config/systemd/user/mihomo_config_server.service
{{ end }}
{{ if not .features.inputMethod }}
.config/fcitx5
.local/share/fcitx5
.local/bin/fcitx5-remote
{{ end }}
{{ if not .features.proxy }}
.local/bin/toggle_proxy
.config/systemd/user/ssh-tunnel@.service
{{ end }}
{{ if not .features.fduConnect }}
.config/fdu-connect
.local/bin/fdu-connect
Library/LaunchAgents/fdu-connect.plist
.config/systemd/user/fdu-connect.service
{{ end }}
{{ if not .features.desktop }}
