{{- $configShareMode := "none" -}}
{{- $configShareItems := "" -}}
{{- if hasKey . "configShare" -}}
{{- $configShareMode = default "none" .configShare.mode -}}
{{- $configShareItems = default "" .configShare.items -}}
{{- end -}}
# Repository-only files.
*.md
*.log
ignore
tools
.config/fcitx5/conf/cached_layouts

# Config groups controlled by host data.
{{ if not .features.cli }}
.local/bin/later
.config/systemd/user/later.path
.config/systemd/user/later.service
{{ end }}
{{ if not .apps.neovim.enabled }}
.config/nvim
{{ end }}
{{ if not .apps.mihomo.enabled }}
.config/mihomo
{{ end }}
{{ if or (ne .chezmoi.os "linux") (eq $configShareMode "none") }}
.config/systemd/user/config-share.service
{{ end }}
{{ if or (ne .chezmoi.os "darwin") (eq $configShareMode "none") }}
Library/LaunchAgents/config-share.plist
{{ end }}
{{ if eq $configShareMode "none" }}
.local/share/config-share
.local/libexec/config-share-server
{{ else }}
{{ if not (contains ",mihomo," (printf ",%s," (replace " " "" $configShareItems))) }}
.local/share/config-share/mihomo
{{ end }}
{{ if not (contains ",surfingkeys," (printf ",%s," (replace " " "" $configShareItems))) }}
.local/share/config-share/surfingkeys
{{ end }}
{{ end }}
{{ if not .apps.mihomo.enabled }}
Library/LaunchAgents/mihomo.plist
{{ end }}
{{ if not .features.inputMethod }}
.config/fcitx5
.local/share/fcitx5
.local/bin/fcitx5-remote
{{ end }}
{{ if not .features.proxy }}
.local/bin/toggle_proxy
.config/systemd/user/ssh-tunnel@.service
{{ end }}
{{ if not .features.fduConnect }}
.config/fdu-connect
.local/bin/fdu-connect
Library/LaunchAgents/fdu-connect.plist
.config/systemd/user/fdu-connect.service
{{ end }}
{{ if not .features.desktop }}
.config/kitty
.config/mpv
.config/sioyek
.config/wezterm
.config/zathura
.local/bin/osc1337-im
.local/bin/sioyek
.local/share/applications/sioyek.desktop
{{ end }}

# macOS-only files.
{{ if ne .chezmoi.os "darwin" }}
install-packages-macos.sh
.gnupg/gpg-agent.conf
.hammerspoon
.config/karabiner
.config/aerospace
.config/yabai
Library
.config/fcitx5/conf/macosfrontend.conf
.config/fcitx5/conf/macosnotifications.conf
.config/fcitx5/conf/imselector.conf
.config/fcitx5/conf/keyboard.conf
{{ end }}

# macOS desktop automation.
{{ if and (eq .chezmoi.os "darwin") (not .features.macDesktop) }}
.hammerspoon
.config/karabiner
.config/aerospace
.config/yabai
{{ end }}

# Linux-only files.
{{ if ne .chezmoi.os "linux" }}
install-packages-linux.sh
.cache/rsync_to_root
.config/hypr
.config/mako
.config/qq-electron-flags.conf
.config/sunshine
.config/systemd
.config/waybar
.config/wireplumber
.config/wofi
.local/bin/qq
.local/bin/later
.local/bin/sioyek
.local/bin/sunshine_pre
.local/bin/tencentqq
.local/share/applications
.config/fcitx5/conf/classicui.conf
.config/fcitx5/conf/kimpanel.conf
.config/fcitx5/conf/notifications.conf
.config/fcitx5/conf/rime.conf
.config/fcitx5/conf/virtualkeyboardadapter.conf
.config/fcitx5/conf/wayland.conf
.config/fcitx5/conf/waylandim.conf
.config/fcitx5/conf/xcb.conf
.config/fcitx5/conf/xim.conf
{{ end }}

# Linux desktop files.
{{ if and (eq .chezmoi.os "linux") (not .features.linuxDesktop) }}
.cache/rsync_to_root
.config/hypr
.config/mako
.config/qq-electron-flags.conf
.config/waybar
.config/wireplumber
.config/wofi
.local/bin/qq
.local/bin/sioyek
.local/bin/tencentqq
.local/share/applications
.config/zathura
{{ end }}

# Optional Linux apps.
{{ if and (eq .chezmoi.os "linux") (not .apps.sunshine.enabled) }}
.config/sunshine
.local/bin/sunshine_pre
{{ end }}
