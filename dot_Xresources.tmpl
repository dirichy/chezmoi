{{- $dpi := output "bash" "-lc" "dpi=; if command -v hyprctl >/dev/null 2>&1; then dpi=$(hyprctl monitors 2>/dev/null | awk 'BEGIN { first_height=0; first_scale=0; height=0; scale=0 } /^[[:space:]]+[0-9]+x[0-9]+@/ { split($1, size, \"x\"); split(size[2], refresh, \"@\"); height=refresh[1]; if (!first_height) first_height=height } /^[[:space:]]+scale:/ { scale=$2; if (!first_scale) first_scale=scale } /^[[:space:]]+focused: yes/ { if (scale > 0) { printf \"%.0f\", 96 * scale; exit } if (height > 0) { printf \"%.0f\", height / 8; exit } } END { if (first_scale > 0) printf \"%.0f\", 96 * first_scale; else if (first_height > 0) printf \"%.0f\", first_height / 8 }'); fi; if [[ -z \"$dpi\" ]] && command -v xrandr >/dev/null 2>&1; then dpi=$(xrandr --query 2>/dev/null | awk '/ connected/ { for (i = 1; i <= NF; i++) { if ($i ~ /^[0-9]+x[0-9]+\\+/) { split($i, res, \"x\"); width=res[1] } if ($i ~ /^[0-9]+mm$/ && $(i+1) == \"x\" && width > 0) { mm=$i; sub(/mm$/, \"\", mm); if (mm > 0) { printf \"%.0f\", width * 25.4 / mm; exit } } } }'); fi; printf '%s' \"${dpi:-96}\"" -}}
Xft.dpi: {{ $dpi }}
