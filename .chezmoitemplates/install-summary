# The manual installer collects all package failures before continuing other steps.
record_failure() {
  FAILURES+=("$1")
  FAILURE_COUNT=$((FAILURE_COUNT + 1))
}

finish_install() {
  local result=$?
  trap - EXIT
  if [[ -n "${SUDO_KEEPALIVE_PID:-}" ]]; then
    kill "$SUDO_KEEPALIVE_PID" 2>/dev/null || true
  fi
  if [[ -n "${PARU_BUILD_DIR:-}" ]]; then
    rm -rf -- "$PARU_BUILD_DIR"
  fi
  if ((result != 0)); then
    record_failure "Installer stopped unexpectedly (exit $result); see diagnostics above."
  fi
  if ((FAILURE_COUNT > 0)); then
    if [[ "$INSTALL_CHECK_ONLY" == 1 ]]; then
      printf '\nWarning: missing dependencies:\n' >&2
      printf '  - %s\n' "${FAILURES[@]}" >&2
      printf 'Run chezmoi x packages (or ignore/bin/dotfiles-packages) to install them; no need to rerun install.sh.\n' >&2
      exit 0
    fi
    printf '\nPackage installation failures:\n' >&2
    printf '  - %s\n' "${FAILURES[@]}" >&2
    exit 1
  fi
  exit 0
}
trap finish_install EXIT
