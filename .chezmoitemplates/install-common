#!/usr/bin/env bash
# Shared installation flow; keep compatible with the Bash 3.2 shipped by macOS.
set -euo pipefail

INSTALL_PHASE={{ .phase | quote }}
INSTALL_PROFILE="${INSTALL_PROFILE-{{ .config.install.profile }}}"
INSTALL_MODULES="${INSTALL_MODULES:-{{ .config.install.modules }}}"
FAILURES=()
FAILURE_COUNT=0

{{ includeTemplate "install-summary" . }}

install_items() {
  local module="$1" kind="$2" spec package missing=0
  shift 2

  printf '\n==> [%s %s]\n' "$module" "$kind"
  for spec in "$@"; do
    # The backend resolves package:command specs and sets PARSED_PACKAGE.
    if package_available "$kind" "$spec"; then
      continue
    fi
    package="$PARSED_PACKAGE"
    missing=$((missing + 1))
    printf 'Installing %s: %s\n' "$kind" "$package"
    if ! install_one_package "$module" "$kind" "$package"; then
      record_failure "[$module $kind] $package"
    fi
  done
  if ((missing == 0)); then
    printf 'All packages or matching commands are already available.\n'
  fi
}

run_profile() {
  local profile="${1//-/_}"
  if declare -F "profile_$profile" >/dev/null 2>&1; then
    "profile_$profile"
  else
    printf 'Unknown profile: %s\n' "$1" >&2
    printf 'Available profiles: headless, minimal, desktop, devbox, full, everything\n' >&2
    exit 2
  fi
}

run_modules() {
  local module
  for module in "$@"; do
    module="${module//-/_}"
    if ! declare -F "module_$module" >/dev/null 2>&1; then
      printf 'Unknown module: %s\n' "$module" >&2
      exit 2
    fi
    if [[ "$INSTALL_PHASE" == before && "$module" != core ]] || [[ "$INSTALL_PHASE" == after && "$module" == core ]]; then
      continue
    fi
    "module_$module"
  done
}

{{ includeTemplate (printf "install-packages-%s" .platform) . }}

if [[ "$INSTALL_PROFILE" == skip ]]; then
  printf 'Install profile is skip; not installing packages.\n'
  exit 0
fi

prepare_installer
if [[ "$INSTALL_PHASE" == before ]]; then
  install_template_dependencies
fi

if [[ -n "$INSTALL_MODULES" ]]; then
  # Split only on commas and whitespace; never expand glob patterns or evaluate shell code.
  selected_modules=()
  read -r -a selected_modules <<<"${INSTALL_MODULES//,/ }"
  run_modules ${selected_modules[@]+"${selected_modules[@]}"}
else
  run_profile "$INSTALL_PROFILE"
fi
