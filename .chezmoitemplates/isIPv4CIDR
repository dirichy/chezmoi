{{- $valid := regexMatch `^((25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\.){3}(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])/(3[0-2]|[12]?[0-9])$` . -}}
{{- if $valid -}}
{{- $parts := splitList "/" . -}}
{{- $address := int64 0 -}}
{{- range splitList "." (index $parts 0) -}}
{{- $address = add (mul $address 256) (int64 .) -}}
{{- end -}}
{{- $hostRange := int64 1 -}}
{{- range until (int (sub 32 (int64 (index $parts 1)))) -}}
{{- $hostRange = mul $hostRange 2 -}}
{{- end -}}
{{- $valid = eq (mod $address $hostRange) (int64 0) -}}
{{- end -}}
{{- $valid -}}
