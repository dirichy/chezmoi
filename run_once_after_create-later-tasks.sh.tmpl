#!/bin/sh
set -eu

default_state_dir={{ joinPath .chezmoi.homeDir ".local/state" | quote }}
state_dir=${XDG_STATE_HOME:-$default_state_dir}/later
tasks_file=$state_dir/tasks

if [ -e "$tasks_file" ]; then
	exit 0
fi

umask 077
mkdir -p "$state_dir"
cat >"$tasks_file" <<'EOF'
# One-off tasks. Fields: date time expiry command
#
# Every uncommented line is pending. Successful tasks are removed; running,
# expired, and failed tasks are commented out with a status marker. Remove the
# marker and leading "#" to retry one.
#
# Expiry units: s (seconds), m (minutes), h (hours), d (days).
# 2026-10-01 23:00 10m ~/.local/bin/backup
EOF
